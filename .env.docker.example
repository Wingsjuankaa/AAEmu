# Images built and pushed to Docker Hub.
AAEMU_IMAGE_TAG=0.3.0.0-alpha
AAEMU_BUILD_CONFIGURATION=Release

# Replace both values before deployment. Do not commit .env.docker.
AAEMU_DB_PASSWORD=replace-with-a-long-random-password
AAEMU_SECRET_KEY=replace-with-a-long-random-shared-key

# Public endpoints. These defaults match the current Playit tunnels.
AAEMU_SERVER_NAME=AAEmu.Game
AAEMU_PUBLIC_GAME_HOST=lightweight-imap.with.playit.plus
AAEMU_PUBLIC_GAME_PORT=1211

# Ports exposed on the Docker host. Playit Login maps 1206 -> 1237,
# Game maps 1211 -> 1239, and Stream maps 1212 -> 1212.
AAEMU_LOGIN_HOST_PORT=1237
AAEMU_GAME_HOST_PORT=1239
AAEMU_STREAM_PORT=1212

# Host paths on the destination server. The client-data directory must contain game_pak.
AAEMU_CLIENT_DATA_PATH=/opt/aaemu/assets/client-data
AAEMU_COMPACT_PATH=/opt/aaemu/assets/compact.sqlite3

# Current custom gameplay defaults.
AAEMU_AUTO_ACCOUNT=true
AAEMU_EXP_RATE=5.0
AAEMU_GROWTH_RATE=100.0
AAEMU_GEODATA_MODE=false
AAEMU_LABOR_MAX=20000
AAEMU_LABOR_MAX_PREMIUM=20000
AAEMU_LABOR_ONLINE_AMOUNT=50
AAEMU_LABOR_ONLINE_PREMIUM_AMOUNT=50
AAEMU_LABOR_TICK_MINUTES=5
AAEMU_LABOR_OFFLINE_AMOUNT=50
AAEMU_LABOR_OFFLINE_PREMIUM_AMOUNT=50
AAEMU_LABOR_OFFLINE_TICK_MINUTES=5

AAEMU_TIMEZONE=America/Santiago
AAEMU_ADMINER_PORT=8080

# Only required when restoring a full mysqldump into a new, empty MySQL volume.
AAEMU_DB_RESTORE_PATH=/opt/aaemu/backups/aaemu-current.sql
