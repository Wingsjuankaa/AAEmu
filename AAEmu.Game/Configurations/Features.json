{
    "Features": {
        // Server-only switches. 10.0.2.13 dropped both bits from the fset blob; the server logic
        // behind them is still live and never needed the client to know about it.
        "TaxItem": true,
        "BackpackProfitShare": true,

        // Feature switches shared by the server and client, keyed by Feature enum name. Anything
        // not listed here stays off. Each bit is serialized into SCInitialConfig for the client,
        // and the corresponding server implementation must check the same bit before running.
        // Bit positions live in Models/Game/Features/Feature.cs.
        "Flags": {
            // Backed by server systems.
            "siege": true,
            "premium": true,
            "ingamecashshop": true,
            "bm_mileage": true,
            "houseTaxPrepay": true,
            "mailCoolTime": true,
            "hud_mail_box_button": true,
            "slave_customize": true,
            "ranking": true,
            "freeLpRaise": true,
            "auctionPostBuff": true,
            "shopOnUI": true,

            // Synthesis / "Item Growth" (합성). The client gates the whole feature on this bit: the
            // tooltip block that prints an item's synthesis EXP bar, the infusion's "grants N EXP"
            // line, and the Synthesis pane under the bag all sit behind a single
            // `fset[17] & 0x20` test (bit 141) and render nothing when it is clear. Without it
            // the data is loaded and correct but invisible, which reads as "synthesis is missing".
            // Server side it gates the ItemEvolving special effect (skill 30666).
            //
            "itemEvolving": true,
            // Replace Stat / synthesis-effect reroll. This exposes both the random and selectable
            // windows; the server validates native skill-object type 9 and replies with opcode 0xCE.
            "itemEvolvingReRoll": true,

            // Temper / Refurbishment. r575 already ships the complete refurbishment ALBs; this
            // bit exposes their tab and is also checked by the server before special effect 126
            // can charge currency, consume a catalyst or mutate ScaledA.
            "itemCapScale": true,

            // Lunagem extraction. r575 ships the complete Extract subtab, but socket_enchant.lua
            // adds it only when bit 169 is present. The reconstructed operation 2 checks the same
            // bit before it can consume a Mornstone, labor or mutate an equipment item.
            "socketExtract": true,

            // Migration Scaling / Bless Uthstin. The exact r575 Character Info pane reads this
            // bit, page records from CharacterState/UnitState and the 0x2EC/0x2ED preview-confirm
            // exchange. The reconstructed server loads item_bless_uthstins and all limits from
            // the retail SQLite, consumes the selected talisman, rolls the stat pair server-side
            // and rejects any forged confirmation. Reset, cap extension and page-management
            // requests currently receive an explicit failure response and do not mutate state.
            "bless_uthstin": true,

            // Item Smelting. Keep disabled in r575: dynamic client acceptance selects recipe 29,
            // whose outputs 43482/43489 are absent from the exact items catalogue. The backend
            // remains available for reconstruction tests and rejects incomplete recipes safely.
            "itemSmelting": false,

            // Ancestral ("heir") progression past the level cap. Both bits are needed:
            // useHeirSkill (202) shows the Heir tab, heirLevel (101) enables the level block
            // inside it (level, exp bar, level-up button, heir stats). With only the first, the
            // tab renders the successor wheel but can never gain a level.
            //
            // What progression costs is entirely down to heir_levels: req_total_exp is always the
            // gate, and req_item_id decides whether material is owed on top of it. Rows without an
            // item are reached on experience alone; rows with one stop short of the threshold
            // until the player spends it through the level-up button. Shipped data has no item on
            // any row, so every heir level comes from experience. Retail charges 1x Honorforged
            // Medal (item 40491) for the first one - set req_item_id/req_item_count on level 0 in
            // the client and server compact.sqlite3 to match it.
            //
            // heir_start_level (55) must also be <= World.PlayerLevelCap or progression cannot
            // begin. Note the 10.0.2.13 client additionally ships its Heir tab hard-disabled in
            // scriptsbin64/x2ui/skill/main_window.alb, which needs its own patch.
            //
            // These switches also gate the matching server behavior. heirLevel controls experience
            // progression and level-up requests; useHeirSkill controls successor activation and
            // reset requests.
            //
            // Disabling these switches affects only future actions. characters.heir_exp and rows in
            // heir_skill_activations are left alone, so a character keeps the heir level already
            // earned - it still counts toward Level + HeirLevel and is still broadcast - and
            // successor skills already chosen stay active. Turning the relevant switch back on
            // resumes from where the character left off. Clear those two tables for a clean slate.
            "useHeirSkill": true,
            "heirLevel": true,

            // Enables Dwarf/Warborn character creation. One bit gates both races; the client tests it
            // as (uint)fset[8] & 0x400, i.e. byte 9 bit 2. Lua exports this bit as itemChangeMapping.
            "dwarfWarborn": true,

            "fset_0_1_unknown": true,

            "fset_4_7_unknown": true,

            // Client-side or data-driven; no server system to back.
            "customsaveload": true,
            "hairTwoTone": true,
            "chatRace": true,
            "show_instance_in_hud": true,
            // Opens the cosplay-looks equipment path (fset bit useCosplayLooksSlot). NPC costumes
            // such as Lucius pack cosplay 16066 attach through slot 27 / EST_COSPLAY.
            "useCosplayLooksSlot": true,

            // Web content. These open URLs built from InitialConfig.Host, which must serve them.
            "eventWebLink": true,
            "use_web_help": true,
            "use_web_diary": true,
            "use_web_messenger": true,
            "use_web_wiki": true,

            // No server implementation yet — the client opens the UI and gets no data back.
            // Set to false to hide them until the systems land.
            "event_center_event_info": true,
            "event_center_content_schedule": true,
            "event_center_today_assignment": true,
            "use_palos_shop": true,

            // Account-security gates, off for development logins.
            "sensitiveOpeartion": false,
            "secondpass": false,
            "itemSecure": false
        }
    }
}
