        {
          "name": "quest-dossier-skips-generic-face-target-enumeration",
          "current_kind": "face_target_profile",
          "direction": "outgoing",
          "relation": "*",
          "neighbor_kind": "face_target",
          "action": "skip",
          "importance": "contextual"
