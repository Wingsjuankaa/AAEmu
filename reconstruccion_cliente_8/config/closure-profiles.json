{
  "format": "AA8_CLOSURE_POLICY_V1",
  "version": 1,
  "profiles": {
    "generic": {
      "limits": {
        "max_depth": 7,
        "max_nodes": 300,
        "max_edges_per_node": 60
      },
      "defaults": {
        "outgoing": {
          "action": "expand",
          "importance": "contextual"
        },
        "incoming": {
          "action": "skip",
          "importance": "contextual"
        }
      },
      "rules": [
        {
          "name": "quest-components-own-quest",
          "current_kind": "quest",
          "direction": "incoming",
          "relation": "belongs_to_quest",
          "neighbor_kind": "quest_component",
          "action": "expand",
          "importance": "required"
        },
        {
          "name": "quest-names-are-context",
          "current_kind": "quest",
          "direction": "incoming",
          "relation": "belongs_to_quest",
          "neighbor_kind": "quest_name",
          "action": "terminal",
          "importance": "contextual"
        },
        {
          "name": "component-acts-own-component",
          "current_kind": "quest_component",
          "direction": "incoming",
          "relation": "references_component",
          "neighbor_kind": "quest_act",
          "action": "expand",
          "importance": "required"
        },
        {
