          "direction": "outgoing",
          "relation": "*",
          "neighbor_kind": "asset_file",
          "action": "terminal",
          "importance": "contextual"
        },
        {
          "name": "surface-references-are-terminal",
          "current_kind": "*",
          "direction": "outgoing",
          "relation": "mentions_*",
          "neighbor_kind": "*",
          "action": "terminal",
          "importance": "contextual"
