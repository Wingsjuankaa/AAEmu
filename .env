# project version
PROJECT_VERSION_PREFIX=0.0.2.0
PROJECT_VERSION_SUFFIX=alpha
COMPOSE_PROJECT_NAME=aaemu8

# build configuration
BUILD_CONFIGURATION=Debug
BUILD_FRAMEWORK=netcoreapp3.1
BUILD_RUNTIME=ubuntu.20.04-x64

# db configuration
DB_USER=root
DB_PASSWORD=password

# Isolated ports for the Kakao 8.0 environment
LOGIN_INTERNAL_PORT=2234
LOGIN_PUBLIC_PORT=2237
GAME_PUBLIC_PORT=2239
STREAM_PUBLIC_PORT=2250
MYSQL_PUBLIC_PORT=23306
ADMINER_PUBLIC_PORT=28080

# Host assets (never committed into the repository)
CLIENT_GAME_PAK=D:/Proyectos/AAemu/client_kakao/ArcheAge_8.0.3.12_14122021_r558734/game_pak
# Generated native AA8 player-combat runtime. Quarantined skills have no
# executable fallback to historical combat rows.
COMPACT_DB=D:/Proyectos/AAemu/client_kakao/compact-8.0-runtime-native-equipment-phase-b8-sockets-v1.sqlite3
